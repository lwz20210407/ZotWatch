# Python
__pycache__/
*.py[cod]
*.pyo
*.so
.venv/
.env

# Data artifacts
/data/*.sqlite
/data/*.index
/data/profile.json
# Built by `profile --local --bundle` and shipped as a release asset, never
# committed: tens of megabytes, replaced on every refresh.
/data/profile-bundle.tar.gz
/data/network-state/
/reports/ranking-*.json
/data/feedback-issues.json
/reports/research-diagnostics.json
/data/cache/
/data/cache/*

# Delivery history is tracked on purpose: it is what stops already-read papers
# from being pushed again, and it used to live only in a 90-day CI artifact.
/data/watch-state/*
!/data/watch-state/state.json

# Reports are tracked so past digests stay reachable. GitHub Pages replaces the
# whole site on every deploy, so an untracked report is gone the moment the next
# digest is published -- including from the links in every email already sent.
/reports/*.html
!/reports/report-*.html
/public/
/reports/email-preview.eml

# Logs and caches
*.log
*.tmp
*.cache

# OS
.DS_Store
/reports/preview/
/reports/digest-*
/data/zh-cache.json
temp-artifact/
